<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.residentfrequency.recorder</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__RECORDER__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOGDIR__/recorder.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/recorder-error.log</string>
</dict>
</plist>
